# HTTP server
PORT=3000
# Host address used by Docker Compose for the published port.
BIND_HOST=127.0.0.1
# Bind to loopback by default. Use 0.0.0.0 only with API_KEY set (for Docker/LAN).
HOST=127.0.0.1

# Leave empty for local Hermes/OpenAI clients. If set, send Authorization: Bearer <API_KEY>.
API_KEY=

# Optional browser CORS origin. Keep empty for CLI/API clients.
CORS_ORIGIN=

# Browser/session settings
BROWSER=chromium
HEADLESS=true

# Prompt/tool budget. Increase only after measuring Qwen context usage.
QWEN_MAX_TOOLS=64

# Primary Qwen account. Keep real credentials only in .env (ignored by Git).
QWEN_EMAIL=
QWEN_PASSWORD=

# Optional rotation accounts (supports _2 through _10).
QWEN_EMAIL_2=
QWEN_PASSWORD_2=
QWEN_EMAIL_3=
QWEN_PASSWORD_3=

# Test-only switches. Keep disabled in deployments.
TEST_MOCK_PLAYWRIGHT=false
RUN_LIVE_QWEN_TESTS=0
